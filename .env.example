# Copy to .env and fill in real values. `.env` is gitignored.

# Required for /api/query (the generation and agent paths).
# Get one at https://console.anthropic.com/. Free retrieval-only smoke tests
# work without it; ingestion + the eval gate do not need it either.
ANTHROPIC_API_KEY=

# Which domain pack the system loads. Only `sample` ships in the public repo.
# Extending with a private domain pack: see ARCHITECTURE.md "Domain isolation".
KNOWLEDGE_DOMAIN=sample

# Postgres + pgvector connection string. The default below matches the
# docker-compose `postgres` service. Use `localhost` instead of `postgres` when
# running the app on the host against docker-compose'd Postgres only.
KNOWLEDGE_DB_DSN=postgresql://postgres:postgres@postgres:5432/postgres

# Where the Streamlit UI looks for the FastAPI backend. Use http://localhost:8000
# when running the UI on the host.
KNOWLEDGE_RAG_API_URL=http://api:8000

# Override the chunks table name (default: chunks). Lets you run multiple
# domains side-by-side in the same Postgres instance.
VECTOR_TABLE=chunks
